# Frontend origin URL, allowed by CORS and by the WebSocket origin check (exact match)
CLIENT_URL=http://localhost:3000

PORT=3001

# Standard Node.js runtime flag. Leave this at production for any deployment.
# Floe never reads it and registers its own final error handler, so a thrown error
# is answered with a generic JSON message at every setting (#239). Express and some
# dependencies still consult it, and the server Docker image sets it for you.
NODE_ENV=production

# Set this to the number of reverse proxies in front of this server. 0 fits the direct
# run this file describes, where browsers and the CLI reach the port themselves. Use 1
# behind a single proxy (Render / Fly / Vercel, or your own nginx or Caddy), and one more
# for each further layer, such as a CDN. It has to match what is really there, because it
# decides which X-Forwarded-For entry the per-address rate limits read. When it is unset
# the server uses 1 (default) and says so in one line at startup.
TRUSTED_PROXY_COUNT=0

# Optional: Override the connection rate limit ceiling (default: 30 per IP per minute).
# Raise this in staging or testing environments that drive many connections from one IP.
# This and every other MAX_* setting below takes a whole number of at least 1. Given
# anything else (0, a negative number, a word), the server keeps the built-in value and
# logs one line that names the variable.
MAX_CONNECTIONS_PER_IP=30

# Optional: Override the /api/code rate limit ceiling (default: 60 per IP per minute,
# shared across POST /api/code and GET /api/code/:code). Raise in CI/staging.
MAX_CODE_REQUESTS_PER_IP=60

# Optional: Failed code lookups allowed per IP per minute (default: 10). Counts only
# misses on GET /api/code/:code, checked before the lookup: a receiver holding a real
# code is never turned away by its own retries, but an address that has spent the budget
# is refused even a working code. This is the guessing budget, not the volume ceiling above.
MAX_FAILED_CODE_RESOLVES=10

# Optional: Max number of simultaneously-live room codes (default: 10000).
# POST /api/code returns 503 once this many codes are active, bounding memory.
# A code is retired as soon as its room pairs, empties, or registers a new code,
# so a slot is normally freed long before the 10 minute expiry.
MAX_ACTIVE_CODES=10000

# Optional: request-link policy file (default: unset, which means request links
# are off). An absolute path to a small JSON file such as {"requestLinks": true}.
# The path is read once at startup; the file's content is re-read every 60 s, so
# turning request links on or off needs no restart. Edit it by writing a temp
# file and renaming it over the old one, then wait up to 60 s. A missing file means
# off, and a file that cannot be read or parsed keeps the previous setting.
POLICY_FILE=

# Optional: Override the /api/turn-credentials rate limit ceiling (default: 20 per IP
# per minute). The web app fetches it on page load, the CLI and Floe Desktop per transfer.
# Raise in CI/staging where runs share one IP: a 429 leaves a client on Google STUN only.
MAX_TURN_REQUESTS_PER_IP=20

# Optional: managed TURN via Cloudflare Realtime (recommended, no public IP needed).
# Create a TURN key at https://dash.cloudflare.com (Realtime > TURN Server) and paste
# the Turn Token ID + its API token below. These take precedence over the coturn vars.
# The API token is a secret; keep it out of version control.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_KEY_API_TOKEN=

# Optional: self-hosted TURN relay (coturn), used when the Cloudflare vars above are unset
# or give no credentials. Without any of these, the server falls back to Google public
# STUN servers. Direct connections still work on most home and mobile networks.
TURN_SECRET=
TURN_DOMAIN=

# Upstash Redis: global transfer stats counter (durable across redeploys)
# Create a free database at https://console.upstash.com and copy the REST URL + token.
# IMPORTANT: use the read+write REST token (shown as the default token in the console),
# NOT the read-only token. The server needs write access to INCRBY the counter; with the
# read-only token, writes are silently rejected and the total never persists.
# If either is left empty, the counter resets to 0 on every server restart (in-memory only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Max bytes accepted in a single /api/stats/report request (default: 5 TiB).
# Rejects implausibly large single-transfer reports.
MAX_REPORT_BYTES=
