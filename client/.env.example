# Optional: Signaling server URL, inlined at build time.
# Local development already defaults to http://localhost:3001 without this, and
# self-hosted Docker instances resolve the address at runtime instead (see
# SELF_HOSTING.md). Set it here only to compile a fixed URL into the bundle,
# which is what floe.one's own deploy does with https://api.floe.one.
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Optional: Public base URL for canonical links, Open Graph tags, and sitemap.
# Set this to your own domain when self-hosting so share previews and SEO point
# at your instance instead of floe.one.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Sentry error tracking (leave empty to disable)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Optional: Umami analytics (leave empty to disable)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
