# Floe self-hosting configuration for docker compose.
# Every value here has a working default, so this file is entirely optional.
# Download it next to docker-compose.yml only if you want to change something:
#   curl -fsSL https://raw.githubusercontent.com/jannskiee/floe/main/.env.docker.example -o .env

# --- Image version ----------------------------------------------------------
# Which published image tag to run. Defaults to `latest`, the newest release.
# Pin an exact version to control when you move, for example FLOE_IMAGE_TAG=1.10.7,
# or use `main` to track the latest merged commit ahead of a release.
#
# Note the name: this is NOT FLOE_VERSION, which belongs to the CLI installer and
# is written with a leading v (v1.10.7). Image tags carry no v, so reusing that
# name would silently resolve to a tag that does not exist.
# FLOE_IMAGE_TAG=1.10.7

# --- Client to server wiring ------------------------------------------------
# URL the BROWSER uses to reach the signaling server. Read at runtime, so changing
# it takes effect on the next `docker compose up -d` with no rebuild.
# Local:      http://localhost:3001
# Two hosts:  https://api.your-domain.com
# One domain: leave EMPTY, and the browser uses whatever host it was loaded from
#             (see docs/self-hosting/reverse-proxy)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Public base URL of your client, used for canonical links, Open Graph share
# previews, and the sitemap.
#
# This one is BAKED IN at build time, because Next writes those tags into the
# prerendered HTML. Setting it here has no effect on a pulled image; the published
# image simply omits those tags rather than claiming a domain it cannot know.
#
# To put your own domain in share previews, build the client yourself:
#   NEXT_PUBLIC_SITE_URL=https://your-domain.com \
#     docker compose -f docker-compose.yml -f docker-compose.build.yml build client
#   docker compose -f docker-compose.yml -f docker-compose.build.yml up -d
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Ports ------------------------------------------------------------------
# Host port the server is published on (container always listens on 3001).
PORT=3001

# Host port the client is published on (container always listens on 3000).
CLIENT_PORT=3000

# --- Server -----------------------------------------------------------------
# Frontend origin allowed by CORS. Set to your client's public URL in production,
# matching scheme and host exactly, with no trailing slash.
CLIENT_URL=http://localhost:3000

# Number of trusted reverse-proxy hops in front of the server (X-Forwarded-For
# parsing for rate limiting). This stack publishes its ports directly, so 0 is
# correct out of the box. Set 1 when you put a reverse proxy in front, or 2 behind
# a proxy plus a CDN. Setting it higher than your real hop count lets clients spoof
# X-Forwarded-For and bypass the per-IP rate limits.
TRUSTED_PROXY_COUNT=0

# Optional: override the connection rate limit ceiling (default: 30 per IP per 60s).
# Raise this in staging or testing environments that drive many connections from one IP.
MAX_CONNECTIONS_PER_IP=30

# Optional: the other per-IP limits. Leave commented to use the defaults shown.
# MAX_TURN_REQUESTS_PER_IP=20    # GET /api/turn-credentials, per IP per 60s
# MAX_CODE_REQUESTS_PER_IP=60    # /api/code endpoints, per IP per 60s
# MAX_ACTIVE_CODES=10000         # live room codes held in memory at once

# --- Optional TURN relay ----------------------------------------------------
# Managed TURN via Cloudflare Realtime (recommended, no public IP needed). Create a
# TURN key at https://dash.cloudflare.com (Realtime > TURN Server) and paste the
# Turn Token ID + API token. These take precedence over the coturn vars below.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_KEY_API_TOKEN=

# Self-hosted coturn (used only if the Cloudflare vars above are unset). Fill both
# in AND start the coturn service (`docker compose --profile turn up -d`) for peers
# behind strict NAT / CGNAT. Create the config first:
#   curl -fsSL --create-dirs -o coturn/turnserver.conf \
#     https://raw.githubusercontent.com/jannskiee/floe/main/coturn/turnserver.conf.example
# TURN_SECRET must match `static-auth-secret` in that file. Skip the download and
# coturn starts on built-in defaults with no secret and relaying silently fails.
# See SELF_HOSTING.md.
TURN_SECRET=
TURN_DOMAIN=

# --- Optional global transfer counter ---------------------------------------
# Durable storage for the public "bytes transferred" counter on the homepage.
# Create a free Redis database at https://console.upstash.com and paste its REST
# URL + token. Leave both empty to run the counter in memory only (it resets to 0
# on every restart). MAX_REPORT_BYTES caps a single report (default 5 TiB).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
MAX_REPORT_BYTES=
